// 4-part software version: MAJOR.MINOR.REVISION.BUILD
// REVISION is the third component (historically called PATCH in Arqma).
// BUILD is bumped for interim release builds; git identity lives in VERSIONTAG.
#define DEF_ARQMA_VERSION_MAJOR 10
#define DEF_ARQMA_VERSION_MINOR 1
#define DEF_ARQMA_VERSION_REVISION 0
#define DEF_ARQMA_VERSION_PATCH DEF_ARQMA_VERSION_REVISION
#define DEF_ARQMA_VERSION_BUILD 1

#define STRINGIFY_2(val) #val
#define STRINGIFY(val) STRINGIFY_2(val)
#define DEF_ARQMA_VERSION_STR \
  STRINGIFY(DEF_ARQMA_VERSION_MAJOR) "." \
  STRINGIFY(DEF_ARQMA_VERSION_MINOR) "." \
  STRINGIFY(DEF_ARQMA_VERSION_REVISION) "." \
  STRINGIFY(DEF_ARQMA_VERSION_BUILD)

#define DEF_ARQMA_VERSION_TAG "@VERSIONTAG@"
#define DEF_ARQMA_RELEASE_NAME "Cipherstorm Vault"
// Full string shape: MAJOR.MINOR.REVISION.BUILD[commit]
#define DEF_ARQMA_VERSION_FULL DEF_ARQMA_VERSION_STR "[" DEF_ARQMA_VERSION_TAG "]"

#define DEF_ARQMA_VERSION_IS_RELEASE @VERSION_IS_RELEASE@

#include "version.h"

// Triple used on SN uptime-proof / RPC wire (major, minor, revision).
const std::array<uint16_t, 3> ARQMA_VERSION = {
    DEF_ARQMA_VERSION_MAJOR, DEF_ARQMA_VERSION_MINOR, DEF_ARQMA_VERSION_REVISION};

const uint32_t ARQMA_VERSION_BUILD = DEF_ARQMA_VERSION_BUILD;

const char* const ARQMA_VERSION_TAG = DEF_ARQMA_VERSION_TAG;
const char* const ARQMA_VERSION_STR = DEF_ARQMA_VERSION_STR;
const char* const ARQMA_RELEASE_NAME = DEF_ARQMA_RELEASE_NAME;
const char* const ARQMA_VERSION_FULL = DEF_ARQMA_VERSION_FULL;

const bool ARQMA_VERSION_IS_RELEASE = DEF_ARQMA_VERSION_IS_RELEASE;
